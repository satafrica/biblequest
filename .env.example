# Copy to .env.local for local development, or add these in Netlify:
# Site configuration -> Environment variables.
#
# Leave both Supabase values empty to build the offline editorial preview
# (bundled questions, practice gems on the device, no accounts).
VITE_SUPABASE_URL=
# The "anon" / "publishable" key from Supabase -> Project Settings -> API.
# NEVER put the service_role / secret key here or anywhere in this project:
# every VITE_ variable is visible to anyone who opens the website.
VITE_SUPABASE_ANON_KEY=
# Optional: an HTTPS endpoint that accepts JSON error reports (no personal data is sent).
VITE_ERROR_ENDPOINT=
