{
  "name": "mybiblegem",
  "private": true,
  "version": "1.0.0-preview.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "lint": "oxlint",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm test && npm run test:db && npm run test:e2e",
    "build:content": "python3 scripts/build_content.py",
    "cap:sync": "npm run build && npx cap sync"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "embedded-postgres": "^18.6.0-beta.19",
    "jsdom": "^29.1.1",
    "oxlint": "^1.90.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12"
  }
}
