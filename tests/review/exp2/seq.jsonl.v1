{"event_checks": [{"event": "Moses sends the spies to search Canaan", "supported_by_text": "yes", "reason": "Numbers 13:17 states Moses sent them to spy out the land of Canaan."}, {"event": "Two men carry a cluster of grapes on a staff", "supported_by_text": "yes", "reason": "Numbers 13:23 says they 'bare it between two upon a staff' at the brook of Eshcol."}, {"event": "Caleb says, Let us go up at once", "supported_by_text": "yes", "reason": "Numbers 13:30 quotes Caleb exactly."}, {"event": "The people murmur against Moses and Aaron", "supported_by_text": "yes", "reason": "Numbers 14:2 states all the children of Israel murmured against Moses and Aaron."}, {"event": "Israel must wander forty years", "supported_by_text": "partly", "reason": "Numbers 14:34 gives the forty years of bearing iniquities. The word 'wander' comes from 14:33, but the meaning is accurate and the paraphrase is acceptable."}], "order_correct": true, "order_ambiguous": "", "title_and_hint_ok": true, "verdict": "pass", "suggested_fix": "", "id": "seq-twelve_spies"}
{"event_checks": [{"event": "Jacob waters Rachel's flock at the well", "supported_by_text": "yes", "reason": "Genesis 29:10 says Jacob rolled the stone away and watered the flock of Laban, the flock Rachel was keeping (29:9). Calling it 'Rachel's flock' is an acceptable paraphrase."}, {"event": "Jacob serves seven years for Rachel", "supported_by_text": "yes", "reason": "Genesis 29:20 states this directly."}, {"event": "Jacob finds he has married Leah", "supported_by_text": "yes", "reason": "Genesis 29:25: 'in the morning, behold, it was Leah.'"}, {"event": "Jacob serves seven more years", "supported_by_text": "yes", "reason": "Genesis 29:30: 'served with him yet seven other years.'"}], "order_correct": true, "order_ambiguous": "", "title_and_hint_ok": true, "verdict": "pass", "suggested_fix": "", "id": "seq-jacob_rachel"}
{"event_checks": [{"event": "David sees a woman from the roof", "supported_by_text": "yes", "reason": "2 Sam 11:2 states that from the roof he saw a woman washing herself."}, {"event": "David writes to set Uriah in the hottest battle", "supported_by_text": "yes", "reason": "2 Sam 11:15 records the letter: 'Set ye Uriah in the forefront of the hottest battle.'"}, {"event": "Nathan says, Thou art the man", "supported_by_text": "yes", "reason": "2 Sam 12:7 quotes this exactly."}, {"event": "David confesses, I have sinned", "supported_by_text": "yes", "reason": "2 Sam 12:13: 'I have sinned against the LORD.'"}, {"event": "Solomon is born", "supported_by_text": "yes", "reason": "2 Sam 12:24 records Bath-sheba bearing a son whom David named Solomon."}], "order_correct": true, "order_ambiguous": "", "title_and_hint_ok": true, "verdict": "pass", "suggested_fix": "", "id": "seq-david_bathsheba"}
{"event_checks": [{"event": "The elders ask Samuel for a king", "supported_by_text": "yes", "reason": "1 Samuel 8:4-5 records the elders of Israel asking Samuel, 'make us a king to judge us like all the nations.'"}, {"event": "Saul, a choice young man, is introduced", "supported_by_text": "yes", "reason": "1 Samuel 9:2 introduces Saul as 'a choice young man, and a goodly.'"}, {"event": "Samuel anoints Saul with a vial of oil", "supported_by_text": "yes", "reason": "1 Samuel 10:1 says Samuel took a vial of oil and poured it upon Saul's head."}, {"event": "The people shout, God save the king", "supported_by_text": "yes", "reason": "1 Samuel 10:24 says all the people shouted, 'God save the king.'"}, {"event": "Samuel tells Saul the LORD has rejected him", "supported_by_text": "yes", "reason": "1 Samuel 15:23 has Samuel say, 'he hath also rejected thee from being king.'"}], "order_correct": true, "order_ambiguous": "", "title_and_hint_ok": true, "verdict": "pass", "suggested_fix": "", "id": "seq-saul_king"}
{"event_checks": [{"event": "Absalom steals the hearts of the men of Israel", "supported_by_text": "yes", "reason": "2 Samuel 15:6 states this directly."}, {"event": "David flees from Jerusalem", "supported_by_text": "yes", "reason": "2 Samuel 15:14 records David commanding his servants to flee, and the flight follows in 15:16-17. The command is a fair basis for the event."}, {"event": "Absalom's head is caught in an oak", "supported_by_text": "yes", "reason": "2 Samuel 18:9 states his head caught hold of the oak."}, {"event": "Joab thrusts three darts into Absalom", "supported_by_text": "yes", "reason": "2 Samuel 18:14 says Joab took three darts and thrust them through Absalom's heart."}, {"event": "David weeps, O my son Absalom", "supported_by_text": "yes", "reason": "2 Samuel 18:33 quotes David's lament."}], "order_correct": true, "order_ambiguous": "", "title_and_hint_ok": true, "verdict": "pass", "suggested_fix": "", "id": "seq-absalom"}
